#!/usr/bin/env bash
# Installs HAProxy and load balances web-01 and web-02 using roundrobin
sudo apt-get update -y
sudo apt-get install -y haproxy
echo "ENABLED=1" | sudo tee -a /etc/default/haproxy > /dev/null
sudo tee -a /etc/haproxy/haproxy.cfg > /dev/null <<'CFG'

frontend http_front
    bind *:80
    mode http
    default_backend http_back

backend http_back
    mode http
    balance roundrobin
    server 7263-web-01 18.175.227.94:80 check
    server 7263-web-02 35.177.58.26:80 check
CFG
sudo service haproxy restart
