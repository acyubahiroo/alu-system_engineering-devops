#!/usr/bin/env bash
# Installs and configures HAproxy on lb-01 to load balance web-01 and web-02 with roundrobin
sudo apt-get update -y
sudo apt-get install -y haproxy

# Make HAproxy manageable via init script
sudo sed -i 's/^ENABLED=.*/ENABLED=1/' /etc/default/haproxy

if ! grep -q "frontend http_front" /etc/haproxy/haproxy.cfg; then
sudo tee -a /etc/haproxy/haproxy.cfg > /dev/null <<'EOF'

frontend http_front
    bind *:80
    mode http
    default_backend http_back

backend http_back
    mode http
    balance roundrobin
    server 7263-web-01 3.8.116.109:80 check
    server 7263-web-02 18.171.175.202:80 check
EOF
fi

sudo service haproxy restart
