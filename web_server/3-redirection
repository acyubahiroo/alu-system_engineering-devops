#!/usr/bin/env bash
# Installs Nginx and configures /redirect_me to redirect with a 301 Moved Permanently
sudo apt-get update -y
sudo apt-get install -y nginx
echo "Holberton School for the win!" | sudo tee /var/www/html/index.html > /dev/null
if ! grep -q "redirect_me" /etc/nginx/sites-available/default; then
    sudo sed -i '/server_name _;/a location /redirect_me { return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4; }' /etc/nginx/sites-available/default
fi
sudo service nginx restart
